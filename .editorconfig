root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.go]
indent_style = tab

[{go.mod,go.work}]
indent_style = tab

[*.{ts,tsx,js,jsx,json,css,html,yml,yaml}]
indent_style = space
indent_size = 2

[*.md]
indent_style = space
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
