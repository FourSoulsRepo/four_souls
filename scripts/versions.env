# Tool versions: the one place to change them (16.8).
# Read by scripts/setup.sh (and make doctor) and by the CI workflows.
# Plain KEY=value lines only: CI copies them into $GITHUB_ENV.
# Go comes from go.mod; Playwright from e2e/package.json.

# Node.js major version; newer majors pass the check.
NODE_VERSION=24
# Wails CLI; keep it equal to github.com/wailsapp/wails/v2 in go.mod.
WAILS_VERSION=v2.16.0
# golangci-lint, built into .cache/bin by scripts/setup.sh.
GOLANGCI_LINT_VERSION=v2.14.0
