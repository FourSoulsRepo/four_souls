# Copy to .env and fill in (8.20).

# The domain players type; it must point at this machine.
DOMAIN=games.example.com

# Server settings; empty keeps the default.
# The name players see instead of the address (up to 40 characters).
FOUR_SOULS_NAME=
# Days to keep match records; 0 keeps them forever. Default 30.
FOUR_SOULS_RETENTION=
# false stops relaying live aiming and hover. Default true.
FOUR_SOULS_PRESENCE=
# End a game nobody is connected to for this many minutes; 0 never. Default 30.
FOUR_SOULS_EMPTY_MINUTES=
# End a game this many hours after it started; 0 never. Default 24.
FOUR_SOULS_GAME_HOURS=
