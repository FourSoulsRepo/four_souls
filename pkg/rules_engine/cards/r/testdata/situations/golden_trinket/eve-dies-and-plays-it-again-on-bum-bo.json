{
  "title": "Eve's line: gold on Tech X; Eve dies and the penalty destroys Golden Trinket; on her next turn Hallowed Ground brings it back to her hand and she puts the new gold on Bum-Bo!: where are the gold counters?",
  "source": ["card golden_trinket", "card tech_x", "card bum_bo", "card hallowed_ground", "card bomb", "R-MECH-12", "R-DEATH-14", "R-DEATH-16", "R-ZONE-06", "R-ABIL-19", "R-CARD-30"],
  "sets": ["b2", "r"],
  "setup": {
    "players": [
      {"character": "eve", "items": ["tech_x", "bum_bo", "hallowed_ground"], "hand": ["golden_trinket", "bomb"], "damage": 1,
       "counters": [{"card": "hallowed_ground", "count": 3}]},
      {"character": "isaac", "cents": 5}
    ],
    "active": 0,
    "loot_plays": 2
  },
  "steps": [
    {"player": 0, "kind": "play", "card": "golden_trinket", "choices": ["tech_x"],
     "expect": {"allowed": true, "after": [{"player": 0, "counters": [{"card": "tech_x", "name": "gold", "count": 1}]}]}},
    {"player": 0, "kind": "play", "card": "bomb", "choices": ["player 1 (eve)", "golden_trinket"],
