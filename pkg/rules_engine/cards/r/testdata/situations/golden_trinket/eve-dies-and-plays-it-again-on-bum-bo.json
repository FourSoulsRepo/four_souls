    {"player": 1, "kind": "end_turn",
     "expect": {"allowed": true, "active": 0, "after": [{"player": 0, "dead": false}]}},
    {"player": 0, "kind": "activate", "card": "hallowed_ground", "ability": 1,
     "expect": {"allowed": true, "discards": {"loot": ["bomb"]}, "after": [{"player": 0, "counters": [{"card": "hallowed_ground", "count": 0}]}]}},
    {"player": 0, "kind": "play", "card": "golden_trinket", "choices": ["bum_bo"]}
